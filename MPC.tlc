%implements  MPC "C"
%% Function: BlockTypeSetup ===================================================
%%
%% Purpose:
%%      Set up external references for wrapper functions in the 
%%      generated code.
%%
%function BlockTypeSetup(block, system) void
    %assign doubleType = LibGetDataTypeNameFromId(::CompiledModel.tSS_DOUBLE)

  %if IsModelReferenceSimTarget() || CodeFormat == "S-Function" || ::isRAccel
    %assign hFileName = "MPC_accel_wrapper"
    %assign hFileNameMacro = FEVAL("upper", hFileName)
    %openfile hFile = "%<hFileName>.h"
    %selectfile hFile
    #ifndef _%<hFileNameMacro>_H_
    #define _%<hFileNameMacro>_H_

    #ifdef MATLAB_MEX_FILE
    #include "tmwtypes.h"
    #else
    %<LibEmitPlatformTypeIncludes()>
    #endif
    #ifdef __cplusplus
    #define SFB_EXTERN_C extern "C"
    #else
    #define SFB_EXTERN_C extern
    #endif
    SFB_EXTERN_C void MPC_Start_wrapper_accel(void);
    SFB_EXTERN_C void MPC_Outputs_wrapper_accel(const %<doubleType> *x_meas,
			const %<doubleType> *ref_setpoint,
			%<doubleType> *u_fuel);
    SFB_EXTERN_C void MPC_Terminate_wrapper_accel(void);
    #undef SFB_EXTERN_C
    #endif
    %closefile hFile

    %assign cFileName = "MPC_accel_wrapper"
    %openfile cFile = "%<cFileName>.cpp"
    %selectfile cFile
    #include <string.h>
    #ifdef MATLAB_MEX_FILE
    #include "tmwtypes.h"
    #else
    %<LibEmitPlatformTypeIncludes()>
    #endif
    #include "%<hFileName>.h"
    

    extern void MPC_Start_wrapper(void);
    extern void MPC_Outputs_wrapper(const %<doubleType> *x_meas,
			const %<doubleType> *ref_setpoint,
			%<doubleType> *u_fuel);
    extern void MPC_Terminate_wrapper(void);
    void MPC_Start_wrapper_accel(void){
    MPC_Start_wrapper();
    }
    void MPC_Outputs_wrapper_accel(const %<doubleType> *x_meas,
			const %<doubleType> *ref_setpoint,
			%<doubleType> *u_fuel){
    MPC_Outputs_wrapper(x_meas,
			ref_setpoint,
			u_fuel);
    }
    void MPC_Terminate_wrapper_accel(void){
    MPC_Terminate_wrapper();
    }

    %closefile cFile

    %<LibAddToCommonIncludes("%<hFileName>.h")>

  %else
    %assign hFileName = "MPC_cgen_wrapper"
    %assign hFileNameMacro = FEVAL("upper", hFileName)
    %openfile hFile = "%<hFileName>.h"
    %selectfile hFile
    #ifndef _%<hFileNameMacro>_H_
    #define _%<hFileNameMacro>_H_

    #ifdef MATLAB_MEX_FILE
    #include "tmwtypes.h"
    #else
    %<LibEmitPlatformTypeIncludes()>
    #endif
    
    #ifdef __cplusplus
    #define SFB_EXTERN_C extern "C"
    #else
    #define SFB_EXTERN_C extern
    #endif
    SFB_EXTERN_C void MPC_Start_wrapper_cgen(void);
    SFB_EXTERN_C void MPC_Outputs_wrapper_cgen(const %<doubleType> *x_meas,
			const %<doubleType> *ref_setpoint,
			%<doubleType> *u_fuel);
    SFB_EXTERN_C void MPC_Terminate_wrapper_cgen(void);
    #undef SFB_EXTERN_C
    #endif
    %closefile hFile

    %assign cFileName = "MPC_cgen_wrapper"
    %openfile cFile = "%<cFileName>.cpp"
    %selectfile cFile
    #include <string.h>
    #ifdef MATLAB_MEX_FILE
    #include "tmwtypes.h"
    #else
    %<LibEmitPlatformTypeIncludes()>
    #endif
    #include "%<hFileName>.h"

	extern void MPC_Start_wrapper(void);
	extern void MPC_Outputs_wrapper(const %<doubleType> *x_meas,
			const %<doubleType> *ref_setpoint,
			%<doubleType> *u_fuel);
	extern void MPC_Terminate_wrapper(void);
	 void MPC_Start_wrapper_cgen(void) {
	MPC_Start_wrapper();
	}
	 void MPC_Outputs_wrapper_cgen(const %<doubleType> *x_meas,
			const %<doubleType> *ref_setpoint,
			%<doubleType> *u_fuel) {
	MPC_Outputs_wrapper(x_meas,
			ref_setpoint,
			u_fuel);
	}
	 void MPC_Terminate_wrapper_cgen(void) {
	MPC_Terminate_wrapper();
	}
    %closefile cFile

    %<LibAddToCommonIncludes("%<hFileName>.h")>

  %openfile externs

    #ifdef __cplusplus
    #define SFB_EXTERN_C extern "C"
    #else
    #define SFB_EXTERN_C extern
    #endif

    SFB_EXTERN_C void MPC_Start_wrapper(void);

    SFB_EXTERN_C void MPC_Outputs_wrapper(const %<doubleType> *x_meas,
			const %<doubleType> *ref_setpoint,
			%<doubleType> *u_fuel);

    SFB_EXTERN_C void MPC_Terminate_wrapper(void);

    #undef SFB_EXTERN_C
  %closefile externs
  %<LibCacheExtern(externs)>

  %endif
  %%
%endfunction


%% Function: Start ============================================================
%%
%function Start(block, system) Output
   /* %<Type> Block: %<Name> */
  
  %if IsModelReferenceSimTarget() || CodeFormat == "S-Function" || ::isRAccel
    MPC_Start_wrapper_accel();
  %else
    MPC_Start_wrapper_cgen();
  %endif

%endfunction
%% Function: Outputs ==========================================================
%%
%% Purpose:
%%      Code generation rules for mdlOutputs function.
%%
%function Outputs(block, system) Output
  %%
  %assign pu0 = LibBlockInputSignalAddr(0, "", "", 0)
  %assign pu1 = LibBlockInputSignalAddr(1, "", "", 0)
  %assign py0 = LibBlockOutputSignalAddr(0, "", "", 0)
  
  %if IsModelReferenceSimTarget() || CodeFormat == "S-Function" || ::isRAccel
    MPC_Outputs_wrapper_accel(%<pu0>, %<pu1>, %<py0>);
  %else
    MPC_Outputs_wrapper_cgen(%<pu0>, %<pu1>, %<py0>);
  %endif

  %%
%endfunction

%% Function: Terminate ========================================================
%%
%function Terminate(block, system) Output
   /* %<Type> Block: %<Name> */
  
  %if IsModelReferenceSimTarget() || CodeFormat == "S-Function" || ::isRAccel
    MPC_Terminate_wrapper_accel();
  %else
    MPC_Terminate_wrapper_cgen();
  %endif

%endfunction

